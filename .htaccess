<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /samrat/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

<FilesMatch "^(composer\.json|composer\.lock|license\.txt|\.gitignore)$">
    Require all denied
</FilesMatch>

Options -Indexes
